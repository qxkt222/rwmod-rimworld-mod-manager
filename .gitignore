# rwmod — RimWorld Mod Manager

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual env
.venv/
venv/

# Frontend
frontend/node_modules/

# Static build output (generated by the frontend build — absent from a fresh
# clone, so run `npm run build` in frontend/ before starting from source)
static/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store

# Env
.env
.env.local

# Test + coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Logs
*.log

# PyInstaller
*.manifest

# SteamCMD (binary — not version controlled)
steamcmd/

# Pre-commit output logs (local — never commit)
precommit_err.txt
precommit_out.txt

# Commit message draft (local working file)
commit_msg.txt

# Type-check / lint caches
.mypy_cache/
.ruff_cache/

# Build logs (local)
iscc_err.txt
iscc_out.txt
pyinstaller_err.txt
pyinstaller_out.txt

# ── local scratch (never commit) ───────────────────────────────────
# .scratch/<feature>/ is this repo's issue-tracker location — see
# docs/agents/issue-tracker.md. Put one-off investigation scripts and specs
# there instead of in the repo root, so their generated data is ignored too.
.scratch/
verify_fixes.py
py_deps/
pip_tmp/
*.bundle
save_*.json
internal_names.json
